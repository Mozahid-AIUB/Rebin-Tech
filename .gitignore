# Next.js build output. Regenerated by `next build`, thousands of files, and
# staging it once was enough to segfault git.
apps/web/.next/
# `next dev` writes here instead, so a build can no longer overwrite the
# running dev server's chunks. See apps/web/next.config.ts.
apps/web/.next-dev/
apps/web/out/
apps/web/next-env.d.ts
