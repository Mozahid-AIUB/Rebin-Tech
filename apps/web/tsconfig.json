{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Declared here, not inherited. `baseUrl` resolves relative to the config
    // that sets it, so the repo-root `.` in tsconfig.base.json would point
    // every `paths` entry below at the monorepo root instead of this app.
    "baseUrl": ".",
    "paths": {
      "@rebin/shared": [
        "../../packages/shared/src"
      ],
      "@rebin/api/src/types.gen": [
        "../../packages/api/src/types.gen"
      ],
      "@/*": [
        "./*"
      ]
    },
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
